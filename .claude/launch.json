{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PyMason Dev Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "."],
      "port": 3000
    },
    {
      "name": "PyMason (Python http.server)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "Electron App",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["electron", "electron/main.js"],
      "port": 0
    }
  ]
}
